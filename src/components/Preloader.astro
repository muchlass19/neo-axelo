---

---

<div
  class="preloader-overlay fixed top-0 left-0 w-full h-full bg-highlight flex justify-center items-center flex-col gap-4 overflow-hidden z-[100]"
>
  <div class="preloader relative w-[70px] h-[16px] overflow-visible">
    <div class="preloader-block">
      <div class="preloader-block">
        <div class="preloader-block">
          <div class="preloader-block"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="preloader-copy uppercase font-archivo text-base-100 font-bold">
    <p>Loading</p>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(SplitText);

  new SplitText(".preloader-copy p", {
    type: "chars",
    charsClass: "char",
  });

  const preloaderBlocks = gsap.utils.toArray(".preloader-block");
  const nestedBlocks = preloaderBlocks.slice(1);

  gsap.set(nestedBlocks, { rotation: -180, transformOrigin: "left center" });

  const tl = gsap.timeline({ delay: 1 });
  tl.to(".char", {
    opacity: 1,
    duration: 0.15,
    stagger: 0.1,
  });

  tl.from(
    ".preloader",
    {
      scale: 0,
      duration: 0.35,
      ease: "back.out(1.8)",
      transformOrigin: "25% center",
    },
    "<",
  );

  tl.to(
    nestedBlocks,
    {
      delay: 0.25,
      rotation: 0,
      duration: 0.65,
      ease: "power3.inOut",
      stagger: 0.75,
    },
    "<",
  );

  tl.to([".preloader-copy", ".preloader-block"], {
    opacity: 0,
    duration: 0.5,
  });

  tl.to(".preloader-overlay", {
    "--wipe": "90deg",
    duration: 1,
    ease: "power3.inOut",
    zIndex: -100,
  });

  const heroSplit = new SplitText(".hero-copy h1", {
    type: "lines",
    linesClass: "block-line",
  });

  const heroLines: any = [];
  const heroReveals: any = [];

  heroSplit.lines.forEach((line) => {
    const wrapper = document.createElement("div");
    wrapper.className = "block-line-wrapper";
    line.parentNode?.insertBefore(wrapper, line);
    wrapper.appendChild(line);

    const white = document.createElement("div");
    white.className = "block-revealer block-white";
    wrapper.appendChild(white);

    const orange = document.createElement("div");
    orange.className = "block-revealer block-orange";
    wrapper.appendChild(orange);

    heroLines.push(line);
    heroReveals.push({ orange, white });
  });

  const revealerBlocks = heroReveals.flatMap((reveal: any) => [
    reveal.orange,
    reveal.white,
  ]);

  gsap.set(heroLines, { opacity: 0 });
  gsap.set(revealerBlocks, { scaleX: 0, transformOrigin: "left center" });

  heroReveals.forEach((reveal: any, index: number) => {
    const line = heroLines[index];
    const position = index === 0 ? "-=0.65" : "-=0.75";

    const lineTl = gsap.timeline();

    [reveal.orange, reveal.white].forEach((block: any, blockIndex: number) => {
      const blockTl = gsap.timeline({ delay: blockIndex * 0.15 });

      blockTl.to(block, {
        scaleX: 1,
        duration: 0.5,
        ease: "power4.inOut",
      });

      blockTl.set(block, { transformOrigin: "right center" });
      blockTl.set(block, {
        scaleX: 0,
        duration: 0.5,
        ease: "power4.inOut",
      });

      lineTl.add(blockTl, 0);
    });

    lineTl.set(line, { opacity: 1 }, 0.5);

    tl.add(lineTl, position);
  });
</script>
