---
import { Image } from "astro:assets";
import anessaWeb from "../../../public/projects/anessa/anessa-web.png";
import daihatsuWeb from "../../../public/projects/daihatsu-web.png";
import daihatsuOm from "../../../public/projects/daihatsu-om.png";
import daihatsuSparepart from "../../../public/projects/daihatsu-sparepart.png";

const projectDefinitions = [
  {
    image: anessaWeb,
    name: "Anessa Main Website",
    summary: "Corporate marketing site for Anessa skincare",
    link: "/projects/anessa-web",
  },
  {
    image: daihatsuWeb,
    name: "Daihatsu Main Website",
    summary: "Official landing page for Daihatsu vehicles",
    link: "/projects/daihatsu-web",
  },
  {
    image: daihatsuOm,
    name: "Daihatsu Owner Manual PWA",
    summary: "Progressive web app for vehicle owner manuals",
    link: "projects/daihatsu-om",
  },
  {
    image: daihatsuSparepart,
    name: "Daihatsu Sparepart Catalog",
    summary: "Digital catalog for genuine Daihatsu spare parts",
    link: "/projects/daihatsu-sparepart",
  },
];

// Urutan 8 item: daftar asal diulang 2x.
const projects = [...projectDefinitions];
const totalProjectCount = projects.length;
const paddedTotal = String(totalProjectCount).padStart(2, "0");
---

<section class="spotlight">
  <div class="project-index">
    <h1>01/{paddedTotal}</h1>
  </div>

  <div class="project-images">
    {
      projects.map((project) => (
        <div class="project-img" data-summary={project.summary}>
          <a
            href={project.link}
            class="project-link"
            aria-label={project.name}
          >
            <Image
              src={project.image}
              alt={project.name}
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      ))
    }
  </div>

  <div class="project-names">
    {projects.map((project) => <p>{project.name}</p>)}
  </div>
</section>

<style>
  .spotlight {
    position: relative;
    width: 100%;
    height: 100svh;
    padding: 2rem;
    overflow: hidden;
  }

  .spotlight .project-index h1 {
    text-transform: uppercase;
    font-size: clamp(3rem, 5vw, 7rem);
    font-weight: 400;
    line-height: 1;
  }

  .spotlight .project-images {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 35%;
    padding: 50svh 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    z-index: -1;
  }

  .spotlight .project-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    opacity: 0.5;
    transition: opacity 0.3s ease;
    overflow: hidden;
  }

  .spotlight .project-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .spotlight .project-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .spotlight .project-names {
    position: absolute;
    right: 2rem;
    bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .spotlight .project-names p {
    color: #4a4a4a;
    transition: color 0.3s ease;
  }

  .spotlight .project-index h1,
  .spotlight .project-images,
  .spotlight .project-names p {
    will-change: transform;
  }

  @media (hover: hover) and (pointer: fine) {
    .spotlight .project-img {
      cursor: none;
    }
  }

  @media (max-width: 1000px) {
    .spotlight .project-images {
      width: calc(100% - 4rem);
      gap: 25svh;
    }

    .spotlight .project-names p {
      color: #ffffff !important;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import Lenis from "lenis";

  gsap.registerPlugin(ScrollTrigger);

  function initSpotlight() {
    const spotlightSection = document.querySelector(
      ".spotlight",
    ) as HTMLElement | null;
    if (!spotlightSection) return;

    // Lenis: inisialisasi sekali saja (guard global).
    let lenis: any = (window as any).__axeloLenis;
    if (!lenis) {
      lenis = new Lenis();
      lenis.on("scroll", ScrollTrigger.update);
      gsap.ticker.add((time: number) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);
      (window as any).__axeloLenis = lenis;
    }

    const projectIndex = spotlightSection.querySelector(
      ".project-index h1",
    ) as HTMLElement | null;
    const projectImgs =
      spotlightSection.querySelectorAll<HTMLElement>(".project-img");
    const projectImagesContainer = spotlightSection.querySelector(
      ".project-images",
    ) as HTMLElement | null;
    const projectNames =
      spotlightSection.querySelectorAll<HTMLElement>(".project-names p");
    const projectNamesContainer = spotlightSection.querySelector(
      ".project-names",
    ) as HTMLElement | null;

    if (!projectIndex || !projectImagesContainer || !projectNamesContainer)
      return;

    const totalProjectCount = projectNames.length;
    if (totalProjectCount === 0) return;

    // Summary tooltip mengikuti kursor (desktop only).
    const isDesktop = window.matchMedia(
      "(hover: hover) and (pointer: fine) and (min-width: 1001px)",
    ).matches;

    if (isDesktop) {
      const tooltip = document.createElement("div");
      tooltip.setAttribute("aria-hidden", "true");
      tooltip.style.cssText =
        "position:fixed;left:0;top:0;pointer-events:none;opacity:0;transition:opacity 150ms ease;" +
        "background:rgba(180,180,180,0.35);color:#fff;font-size:0.8rem;line-height:1.15;" +
        "width:160px;height:160px;padding:12px;box-sizing:border-box;display:flex;align-items:center;" +
        "justify-content:center;text-align:center;border-radius:50%;border:1px solid rgba(255,255,255,0.25);" +
        "max-width:160px;max-height:160px;overflow:hidden;z-index:9999;" +
        "text-shadow:0 1px 6px rgba(0,0,0,0.8);";
      document.body.appendChild(tooltip);

      spotlightSection
        .querySelectorAll<HTMLElement>(".project-img")
        .forEach((img) => {
          img.addEventListener("mouseenter", () => {
            tooltip.textContent = img.getAttribute("data-summary") || "";
            tooltip.style.opacity = "1";
          });
          img.addEventListener("mousemove", (event: MouseEvent) => {
            tooltip.style.left = `${event.clientX + 16}px`;
            tooltip.style.top = `${event.clientY + 16}px`;
          });
          img.addEventListener("mouseleave", () => {
            tooltip.style.opacity = "0";
          });
        });
    }

    const measure = () => {
      const spotlightSectionHeight = spotlightSection.offsetHeight;
      const spotlightSectionPadding =
        parseFloat(getComputedStyle(spotlightSection).padding) || 0;
      const projectIndexHeight = projectIndex.offsetHeight;
      const containerHeight = projectNamesContainer.offsetHeight;
      const imagesHeight = projectImagesContainer.offsetHeight;

      const moveDistanceIndex =
        spotlightSectionHeight -
        spotlightSectionPadding * 2 -
        projectIndexHeight;
      const moveDistanceNames =
        spotlightSectionHeight - spotlightSectionPadding * 2 - containerHeight;
      const moveDistanceImages = window.innerHeight - imagesHeight;

      const imgActivationThreshold = window.innerHeight / 2;

      ScrollTrigger.getAll().forEach((trigger: any) => {
        if (trigger.trigger === spotlightSection) trigger.kill();
      });

      ScrollTrigger.create({
        trigger: spotlightSection,
        start: "top top",
        end: `+=${window.innerHeight * 5}px`,
        pin: true,
        pinSpacing: true,
        scrub: 1,
        onUpdate: (self: any) => {
          const progress = self.progress;
          const currentIndex = Math.min(
            Math.floor(progress * totalProjectCount) + 1,
            totalProjectCount,
          );

          projectIndex.textContent = `${String(currentIndex).padStart(2, "0")}/${String(totalProjectCount).padStart(2, "0")}`;

          gsap.set(projectIndex, { y: progress * moveDistanceIndex });
          gsap.set(projectImagesContainer, {
            y: progress * moveDistanceImages,
          });

          projectImgs.forEach((img) => {
            const imgRect = img.getBoundingClientRect();
            if (
              imgRect.top <= imgActivationThreshold &&
              imgRect.bottom >= imgActivationThreshold
            ) {
              gsap.set(img, { opacity: 1 });
            } else {
              gsap.set(img, { opacity: 0.5 });
            }
          });

          projectNames.forEach((p, index) => {
            const startProgress = index / totalProjectCount;
            const endProgress = (index + 1) / totalProjectCount;
            const projectProgress = Math.max(
              0,
              Math.min(
                1,
                (progress - startProgress) / (endProgress - startProgress),
              ),
            );
            gsap.set(p, { y: -projectProgress * moveDistanceNames });
            gsap.set(p, {
              color:
                projectProgress > 0 && projectProgress < 1
                  ? "#ffffff"
                  : "#4a4a4a",
            });
          });
        },
      });

      ScrollTrigger.refresh();
    };

    // Tunggu gambar/layout siap.
    if (document.readyState === "complete") {
      measure();
    } else {
      window.addEventListener("load", measure, { once: true });
    }

    // Hitung ulang ketika layout berubah.
    const onResize = () => ScrollTrigger.refresh();
    window.addEventListener("resize", onResize);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSpotlight, {
      once: true,
    });
  } else {
    initSpotlight();
  }
</script>
