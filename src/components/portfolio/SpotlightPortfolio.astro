---
// F1-19 (frame `design/axelo-home-1440.png` + `-375.png`, commit figcraft):
// section WORK disusun ulang sesuai design.
//
// Sebelumnya (design lama dari repo asal): counter `01/04` di kiri sebagai
// headline besar yang ikut meluncur, gambar bertumpuk di tengah, dan nama project
// kecil rata kanan di pojok bawah.
//
// Design FigCraft: counter kecil di kiri atas, **nama project jadi elemen besar**
// di kolom kiri (aktif putih, sisanya muted), preview gambar di kolom kanan, plus
// satu baris caption di bawah preview (`PROJECT 01 — NAME` + link case study).
import { Image } from "astro:assets";
import { PROJECTS, paddedProjectCount } from "../../data/projects";
import { COPY } from "../../config/copy";

const projects = [...PROJECTS];
const paddedTotal = paddedProjectCount();
const pad = (value: number): string => String(value).padStart(2, "0");
---

<section class="spotlight" id="work">
  <div class="project-index">
    <p>{pad(1)}/{paddedTotal}</p>
  </div>

  <div class="project-names">
    {
      projects.map((project) => (
        <a href={project.link} class="project-name">
          {project.shortName}
        </a>
      ))
    }
  </div>

  <div class="project-preview">
    <div class="project-band">
      <div class="project-images">
        {
          projects.map((project) => (
            <div class="project-img" data-summary={project.summary}>
              <a
                href={project.link}
                class="project-link"
                aria-label={project.name}
                tabindex="-1"
              >
                <Image
                  src={project.image}
                  alt={project.name}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="project-caption">
    <p class="project-caption-title" data-prefix={COPY.work.labelPrefix}>
      {COPY.work.labelPrefix} {pad(1)} — {projects[0].shortName}
    </p>
    <a class="project-caption-link" href={projects[0].link}>
      {COPY.work.openCaseStudy}<span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .spotlight {
    position: relative;
    width: 100%;
    height: 100svh;
    padding: 2rem;
    overflow: hidden;
  }

  /* Counter: label kecil di kiri atas (dulu headline besar yang ikut meluncur). */
  .spotlight .project-index {
    position: absolute;
    /* Section ini di-pin di `top top`, sementara nav-nya sticky dan nutupin
       ~93px pertama — tanpa offset ini counter-nya ada DI BELAKANG nav. */
    top: calc(var(--nav-h, 93px) + 0.75rem);
    left: 2rem;
    z-index: 2;
  }

  .spotlight .project-index p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8125rem;
    line-height: 1;
    color: #ffffff;
  }

  /* Nama project: elemen terbesar di section ini, kolom kiri. */
  .spotlight .project-names {
    position: absolute;
    top: calc(var(--nav-h, 93px) + 3.75rem);
    left: 2rem;
    max-width: 36%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    z-index: 2;
  }

  .spotlight .project-names a {
    display: block;
    margin: 0;
    text-decoration: none;
    font-family: var(--font-archivo), sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.25rem, 2.2vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #4a4a4a;
    transition: color 0.3s ease;
  }

  .spotlight .project-names a:hover,
  .spotlight .project-names a:focus-visible {
    color: #ffffff;
  }

  /* Kolom kanan. Caption punya strip sendiri di bawah, jadi gambar nggak pernah
     numpuk teks caption; `bottom` dipakai biar tingginya nggak perlu angka mati. */
  .spotlight .project-preview {
    position: absolute;
    top: 0;
    right: 2rem;
    bottom: 4.5rem;
    width: 56%;
    overflow: hidden;
  }

  .spotlight .project-band {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* Padding atas/bawah di-set dari JS: separuh tinggi band, supaya gambar
     pertama duduk tepat di tengah band waktu progres 0 (reel-nya nggak meleset
     satu). Angka mati `50svh` dulu cuma benar selama band = setinggi viewport. */
  .spotlight .project-images {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    z-index: 1;
  }

  .spotlight .project-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    opacity: 0.5;
    transition: opacity 0.3s ease;
    overflow: hidden;
  }

  .spotlight .project-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .spotlight .project-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Caption di bawah preview — dua baris dari design, nilai-nya diisi ulang oleh
     handler scroll (angka + nama + href ikut project yang sedang aktif). */
  .spotlight .project-caption {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    width: 56%;
    left: auto;
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .spotlight .project-caption p {
    margin: 0;
    color: #818081;
  }

  .spotlight .project-caption-link {
    color: #ffffff;
    white-space: nowrap;
  }

  .spotlight .project-caption-link:hover,
  .spotlight .project-caption-link:focus-visible {
    color: var(--color-highlight);
  }

  .spotlight .project-images {
    will-change: transform;
  }

  @media (hover: hover) and (pointer: fine) {
    .spotlight .project-img {
      cursor: none;
    }
  }

  @media (max-width: 1000px) {
    .spotlight .project-index {
      top: calc(var(--nav-h, 77px) + 0.5rem);
      left: 1.25rem;
    }

    .spotlight .project-names {
      top: calc(var(--nav-h, 77px) + 3rem);
      left: 1.25rem;
      max-width: 82%;
    }

    .spotlight .project-names a {
      /* 4 nama harus tetap SATU baris di 375/320 (design). Di 7,5vw nama
         terpanjang ("Daihatsu Sparepart") keukur 2 baris, jadi tier-nya turun. */
      font-size: clamp(1.25rem, 6.2vw, 2rem);
    }

    /* Band preview: nama di atas, gambar di bawahnya, caption paling bawah —
       jadi gambar nggak pernah nutupin nama (design 375). */
    .spotlight .project-preview {
      top: auto;
      bottom: 4.75rem;
      left: 1.25rem;
      right: 1.25rem;
      width: auto;
      height: 34%;
    }

    .spotlight .project-images {
      width: 100%;
      gap: 1rem;
    }

    .spotlight .project-caption {
      left: 1.25rem;
      right: 1.25rem;
      width: auto;
      bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import Lenis from "lenis";
  import { initRemeasure, onRemeasure } from "../../scripts/remeasure";

  gsap.registerPlugin(ScrollTrigger);
  initRemeasure();

  function initSpotlight() {
    const spotlightSection = document.querySelector(
      ".spotlight",
    ) as HTMLElement | null;
    if (!spotlightSection) return;

    // Lenis: inisialisasi sekali saja (guard global).
    let lenis: any = (window as any).__axeloLenis;
    if (!lenis) {
      lenis = new Lenis();
      lenis.on("scroll", ScrollTrigger.update);
      gsap.ticker.add((time: number) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);
      (window as any).__axeloLenis = lenis;
    }

    const projectIndex = spotlightSection.querySelector(
      ".project-index p",
    ) as HTMLElement | null;
    const projectImgs =
      spotlightSection.querySelectorAll<HTMLElement>(".project-img");
    const projectImagesContainer = spotlightSection.querySelector(
      ".project-images",
    ) as HTMLElement | null;
    const projectNames =
      spotlightSection.querySelectorAll<HTMLElement>(".project-names a");
    const projectNamesContainer = spotlightSection.querySelector(
      ".project-names",
    ) as HTMLElement | null;
    const previewBox = spotlightSection.querySelector(
      ".project-preview",
    ) as HTMLElement | null;
    const captionTitle = spotlightSection.querySelector(
      ".project-caption-title",
    ) as HTMLElement | null;
    const captionLink = spotlightSection.querySelector(
      ".project-caption-link",
    ) as HTMLAnchorElement | null;

    if (!projectIndex || !projectImagesContainer || !projectNamesContainer)
      return;

    const totalProjectCount = projectNames.length;
    if (totalProjectCount === 0) return;

    const pad2 = (value: number): string => String(value).padStart(2, "0");
    const prefix = captionTitle?.dataset.prefix ?? "Project";
    const projectNamesText = [...projectNames].map(
      (p) => p.textContent?.trim() ?? "",
    );
    const projectLinks = [...spotlightSection.querySelectorAll<HTMLAnchorElement>(
      ".project-img .project-link",
    )].map((a) => a.getAttribute("href") ?? "");

    // Summary tooltip mengikuti kursor (desktop only).
    const isDesktop = window.matchMedia(
      "(hover: hover) and (pointer: fine) and (min-width: 1001px)",
    ).matches;

    if (isDesktop) {
      const tooltip = document.createElement("div");
      tooltip.setAttribute("aria-hidden", "true");
      tooltip.style.cssText =
        "position:fixed;left:0;top:0;pointer-events:none;opacity:0;transition:opacity 150ms ease;" +
        "background:rgba(180,180,180,0.35);color:#fff;font-size:0.8rem;line-height:1.15;" +
        "width:160px;height:160px;padding:12px;box-sizing:border-box;display:flex;align-items:center;" +
        "justify-content:center;text-align:center;border-radius:50%;border:1px solid rgba(255,255,255,0.25);" +
        "max-width:160px;max-height:160px;overflow:hidden;z-index:9999;" +
        "text-shadow:0 1px 6px rgba(0,0,0,0.8);";
      document.body.appendChild(tooltip);

      spotlightSection
        .querySelectorAll<HTMLElement>(".project-img")
        .forEach((img) => {
          img.addEventListener("mouseenter", () => {
            tooltip.textContent = img.getAttribute("data-summary") || "";
            tooltip.style.opacity = "1";
          });
          img.addEventListener("mousemove", (event: MouseEvent) => {
            tooltip.style.left = `${event.clientX + 16}px`;
            tooltip.style.top = `${event.clientY + 16}px`;
          });
          img.addEventListener("mouseleave", () => {
            tooltip.style.opacity = "0";
          });
        });
    }

    const measure = () => {
      const spotlightSectionHeight = spotlightSection.offsetHeight;
      const spotlightSectionPadding =
        parseFloat(getComputedStyle(spotlightSection).padding) || 0;

      // Band = elemen .project-preview (kolom kanan yang di-clip). Desktop:
      // setinggi section dikurangi strip caption. Mobile: band 34% di bawah nama,
      // jadi reel-nya cuma lewat band itu dan nggak nabrak nama.
      const bandHeight = previewBox?.offsetHeight ?? window.innerHeight;

      // Padding = separuh tinggi band (bukan angka mati): bikin gambar pertama
      // duduk di tengah band waktu progres 0, dan bikin jarak reel = tinggi
      // tumpukan gambar (jadi gambar terakhir juga mendarat di tengah).
      if (previewBox) {
        const half = `${Math.round(bandHeight / 2)}px`;
        projectImagesContainer.style.paddingTop = half;
        projectImagesContainer.style.paddingBottom = half;
      }

      const imagesHeight = projectImagesContainer.offsetHeight;
      const moveDistanceImages = bandHeight - imagesHeight;

      ScrollTrigger.getAll().forEach((trigger: any) => {
        if (trigger.trigger === spotlightSection) trigger.kill();
      });

      ScrollTrigger.create({
        trigger: spotlightSection,
        start: "top top",
        end: `+=${window.innerHeight * 5}px`,
        pin: true,
        pinSpacing: true,
        scrub: 1,
        onUpdate: (self: any) => {
          const progress = self.progress;
          const currentIndex = Math.min(
            Math.floor(progress * totalProjectCount) + 1,
            totalProjectCount,
          );

          projectIndex.textContent = `${pad2(currentIndex)}/${pad2(totalProjectCount)}`;

          // Counter-nya label diam di kiri atas (design), jadi dia nggak ikut
          // meluncur kayak versi lama yang headline besar.
          gsap.set(projectImagesContainer, {
            y: progress * moveDistanceImages,
          });

          if (captionTitle) {
            captionTitle.textContent = `${prefix} ${pad2(currentIndex)} — ${
              projectNamesText[currentIndex - 1] ?? ""
            }`;
          }
          if (captionLink && projectLinks[currentIndex - 1]) {
            captionLink.setAttribute("href", projectLinks[currentIndex - 1]);
          }

          // Threshold dihitung dari posisi section saat ini + offset band di
          // dalamnya — rect yang diukur sekali di `measure()` basi begitu pin
          // mulai jalan (dan itu bikin nggak ada gambar yang pernah nyala).
          const imgActivationThreshold = previewBox
            ? spotlightSection.getBoundingClientRect().top +
              previewBox.offsetTop +
              previewBox.offsetHeight / 2
            : window.innerHeight / 2;

          projectImgs.forEach((img) => {
            const imgRect = img.getBoundingClientRect();
            if (
              imgRect.top <= imgActivationThreshold &&
              imgRect.bottom >= imgActivationThreshold
            ) {
              gsap.set(img, { opacity: 1 });
            } else {
              gsap.set(img, { opacity: 0.5 });
            }
          });

          // Nama project: list diam + state aktif. Reel vertikal lama bikin nama
          // meluncur ke ATAS keluar section (di komposisi baru, list-nya duduk di
          // bawah nav), jadi yang tersisa cuma penanda aktif — bukan gerak.
          const activeNameIndex = Math.min(currentIndex - 1, totalProjectCount - 1);
          projectNames.forEach((p, index) => {
            gsap.set(p, {
              color: index === activeNameIndex ? "#ffffff" : "#4a4a4a",
            });
          });
        },
      });

      ScrollTrigger.refresh();
    };

    // Tunggu gambar/layout siap.
    if (document.readyState === "complete") {
      measure();
    } else {
      window.addEventListener("load", measure, { once: true });
    }

    // T-08: font swap mengubah tinggi `.project-names`, jadi jarak pin harus
    // DIHITUNG ULANG (bukan cuma refresh posisi). Hook remeasure sudah mencakup
    // resize (debounced) + fonts.ready, jadi listener resize lokal dihapus.
    onRemeasure(measure);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSpotlight, {
      once: true,
    });
  } else {
    initSpotlight();
  }
</script>
