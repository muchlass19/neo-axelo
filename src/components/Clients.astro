---
// F1-05 — client index dalam bentuk type (nol aset, nol marquee, nol hover).
// Reveal: `lines` 0.6s stagger 0.06 (spec @motion-designer) — teksnya satu alur,
// jadi splitter baris dipakai apa adanya, bukan mode anak-elemen.
import { COPY } from "../config/copy";

const { label, names } = COPY.clients;
const index = names.join("  /  ");
---

<section
  id="clients"
  class="px-4 md:px-12 max-[340px]:px-3 py-12 md:py-[5.5rem] border-y border-base-300/40"
>
  <div class="grid gap-3 md:grid-cols-[14rem_1fr] md:gap-8 items-baseline">
    <p class="text-label-lg font-ibm uppercase tracking-tight text-foreground-muted">
      {label}
    </p>
    <p
      class="text-label-lg font-ibm uppercase tracking-tight"
      data-reveal="lines"
      data-reveal-duration="0.6"
      data-reveal-stagger="0.06"
    >
      {index}
    </p>
  </div>
</section>
