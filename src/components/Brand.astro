---
import { Image } from "astro:assets";
import astra from "../../public/astra.svg";
import bcalife from "../../public/bcalife.png";
import byd from "../../public/byd.svg";
import chery from "../../public/chery.svg";
import daihatsu from "../../public/daihatsu.svg";
import danareksa from "../../public/danareksa.png";

const brands = [
  { src: astra, alt: "Astra Logo" },
  { src: bcalife, alt: "BCALife Logo" },
  { src: byd, alt: "BYD Logo" },
  { src: chery, alt: "Chery Logo" },
  { src: daihatsu, alt: "Daihatsu Logo" },
  { src: danareksa, alt: "Danareksa Logo" },
];
---

<div class="brand-slider left-anime-text flex items-center overflow-hidden py-4">
  {
    brands.map((brand) => (
      <Image class="brand w-[120px]" src={brand.src} alt={brand.alt} />
    ))
  }
</div>

<script>
  import gsap from "gsap";
  import { initRemeasure, onRemeasure } from "../scripts/remeasure";

  interface HorizontalLoopConfig {
    speed?: number;
    paddingRight?: number;
  }

  const REDUCED_QUERY = "(prefers-reduced-motion: reduce)";

  // T-06: reaksi scroll-velocity (`Observer.create({ onChangeY })`) DIBUANG —
  // itu otoritas scroll kedua di halaman yang udah punya Lenis, dan itu juga
  // yang pertama harus mati di bawah prefers-reduced-motion.
  function horizontalLoop(
    items: HTMLElement[],
    config: HorizontalLoopConfig = {},
  ): gsap.core.Timeline {
    const gap = config.paddingRight ?? 8;
    const speed = (config.speed ?? 1) * 100;

    const tl = gsap.timeline({
      repeat: -1,
      defaults: { ease: "none" },
    });

    if (items.length === 0) return tl;

    const container = items[0].parentElement;
    if (!container) return tl;

    const positions = items.map((element) => ({
      element,
      width: element.getBoundingClientRect().width,
    }));

    const totalWidth = positions.reduce(
      (total, item) => total + item.width + gap,
      0,
    );

    let currentX = 0;

    positions.forEach(({ element, width }) => {
      const startX = currentX;
      const distance = width + gap;

      gsap.set(element, { x: startX });

      tl.to(
        element,
        {
          x: startX - totalWidth,
          duration: totalWidth / speed,
        },
        0,
      );

      // Setelah keluar dari kiri, tempatkan logo di ujung kanan.
      tl.set(
        element,
        {
          x: startX + totalWidth,
        },
        totalWidth / speed,
      );

      currentX += distance;
    });

    return tl;
  }

  const slider = document.querySelector<HTMLElement>(".brand-slider");
  const items = gsap.utils.toArray<HTMLElement>(".brand-slider .brand");

  let loop: gsap.core.Timeline | null = null;

  function buildLoop(): void {
    loop?.kill();
    gsap.set(items, { clearProps: "transform" });

    if (window.matchMedia(REDUCED_QUERY).matches) {
      // Reduced motion: deret logo statis, nol auto-play.
      gsap.set(items, { x: 0 });
      return;
    }

    loop = horizontalLoop(items, { speed: 0.25, paddingRight: 8 });
  }

  if (slider && items.length > 0) {
    buildLoop();

    // T-08: lebar logo (dan karenanya posisi-x) diukur sekali saat init;
    // setelah font/gambar settle, ukur ulang.
    onRemeasure(buildLoop);
    window.matchMedia(REDUCED_QUERY).addEventListener("change", buildLoop);
  }

  initRemeasure();
</script>
