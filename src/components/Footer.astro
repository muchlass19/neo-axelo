---
// F1-04 — Footer.
// Default @project-manager (basis locomotive + basement.studio): wordmark
// `AXELO.DEV` duduk di atas footer, nav kiri, kontak kanan (nomor + email +
// tombol copy), social sebagai baris mono di bawah — dan baris social cuma
// ke-render kalau ada isinya (jadi F1-04 jalan tanpa URL social).
// Presisi @figcraft-designer: wordmark WAJIB dua span (`AXELO` / `.DEV`),
// satu string nggak bisa wrap karena satu token (355px di box 343 @375).
// Motion: satu clip di container-nya, bukan per span.
import CopyButton from "./ui/CopyButton.astro";
import { COPY } from "../config/copy";
import {
  CONTACT,
  activeSocials,
  mailtoHref,
  navLinks,
  sectionHref,
  whatsappDisplay,
  whatsappHref,
  SITE,
} from "../config/site";

const { navLabel, contactLabel, socialsLabel, backToTop } = COPY.footer;
const pathname = Astro.url.pathname;

const links = navLinks();
const socials = activeSocials();
const wa = whatsappHref();
const mail = mailtoHref();
const phoneText = whatsappDisplay();
const emailText = CONTACT.email.trim();
---

<footer class="px-4 md:px-12 pt-16 md:pt-24 pb-10 border-t border-base-300/40">
  <div
    class="text-display font-archivo font-bold uppercase leading-none"
    data-reveal="clip"
    data-reveal-duration="0.8"
  >
    <span class="block md:inline">AXELO</span><span class="block md:inline"
      >.DEV</span
    >
  </div>

  <div
    class="mt-10 md:mt-16 grid gap-8 md:grid-cols-2"
    data-reveal="fade"
    data-reveal-duration="0.5"
    data-reveal-stagger="0.08"
  >
    <nav aria-label={navLabel}>
      <p class="text-label font-ibm uppercase tracking-tight text-foreground-muted">
        {navLabel}
      </p>
      <ul class="mt-3 flex flex-col gap-2 list-none p-0 font-ibm text-label-lg">
        {
          links.map((link) => (
            <li>
              <a
                href={sectionHref(link.id, pathname)}
                class="transition-colors hover:text-highlight focus-visible:text-highlight"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={sectionHref("top", pathname)}
            class="transition-colors hover:text-highlight focus-visible:text-highlight"
          >
            {backToTop}
          </a>
        </li>
      </ul>
    </nav>

    <div class="md:text-right">
      <p class="text-label font-ibm uppercase tracking-tight text-foreground-muted">
        {contactLabel}
      </p>
      <div class="mt-3 flex flex-col gap-2 font-ibm text-label-lg md:items-end">
        {phoneText && <a href={wa}>{phoneText}</a>}
        {emailText && <a href={mail} class="break-all">{emailText}</a>}
        {
          emailText && (
            <CopyButton value={emailText} label={COPY.contact.copyCta} />
          )
        }
      </div>
    </div>
  </div>

  {
    socials.length > 0 && (
      <div
        class="mt-10 flex flex-col gap-2 md:flex-row md:items-baseline md:gap-8"
        data-reveal="fade"
        data-reveal-duration="0.5"
        data-reveal-delay="0.15"
      >
        <p class="text-label font-ibm uppercase tracking-tight text-foreground-muted">
          {socialsLabel}
        </p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 list-none p-0 font-ibm text-label-lg">
          {socials.map((social) => (
            <li>
              <a href={social.url} target="_blank" rel="noopener noreferrer">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <p class="mt-10 font-ibm text-label text-foreground-muted">
    © {new Date().getFullYear()} {SITE.name}
  </p>
</footer>
