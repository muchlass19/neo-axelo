---
// F1-04 v2 (frame footer-v2 @figcraft-designer, commit bd44569) — footer jadi
// penutup yang beneran kebaca "hubungi kami", di home DAN project page.
//
// Perubahan dari v1 (angka frame 1440 → 490 dari 584):
// - Kontak naik jadi elemen dominan: nomor + email **40px putih** (dulu 15,84px,
//   setara link nav) dan dipindah ke kolom kiri.
// - Wordmark turun ke bawah sebagai watermark **96px `#4a4a4a`** (dulu 172,8px
//   putih di paling atas, 233px glyph = ~40% tinggi footer). Warna itu nilai yang
//   sudah dipakai spotlight buat nama project non-aktif, jadi bukan warna baru.
// - Menu tetap kolom kanan (di-align kanan), plus baris bawah: copyright kiri,
//   tagline kanan.
// - `--nav-h` nggak kesentuh: footer bukan sticky, jadi nol dependency ke handler
//   anchor (nilai `--nav-h` di-set Navbar dari tinggi header, bukan dari sini).
import CopyButton from "./ui/CopyButton.astro";
import { COPY } from "../config/copy";
import {
  CONTACT,
  activeSocials,
  mailtoHref,
  navLinks,
  sectionHref,
  whatsappDisplay,
  whatsappHref,
  SITE,
} from "../config/site";

const { navLabel, contactLabel, socialsLabel, backToTop } = COPY.footer;
// Tagline baris bawah di-derive dari `services.items` (@creative-researcher,
// ratifikasi @project-manager): daftar pekerjaan, bukan kalimat sifat, dan nggak
// bisa basi kalau layanannya berubah. Di 320 dia wrap 2 baris — sengaja dibiarin:
// hide-by-width beda kelas dari hide-by-empty-content (konvensi socials).
const serviceTagline = COPY.services.items.map((item) => item.label).join(" · ");
const pathname = Astro.url.pathname;

const links = navLinks();
const socials = activeSocials();
const wa = whatsappHref();
const mail = mailtoHref();
const phoneText = whatsappDisplay();
const emailText = CONTACT.email.trim();

// Satu tier buat nomor + email: 40px @1440 (dari frame), 24px di mobile.
const CONTACT_VALUE_CLASS =
  "font-ibm leading-tight text-[clamp(1.5rem,2.8vw,2.5rem)]";
---

<footer
  class="px-4 md:px-12 max-[340px]:px-3 pt-10 md:pt-14 pb-10 border-t border-base-300/40"
>
  <div class="grid gap-5 md:grid-cols-2 md:gap-8">
    <div data-reveal="fade" data-reveal-duration="0.5">
      <p class="text-label font-ibm uppercase tracking-tight text-foreground-muted">
        {contactLabel}
      </p>
      <div class="mt-3 flex flex-col gap-1.5">
        {phoneText && <a href={wa} class={CONTACT_VALUE_CLASS}>{phoneText}</a>}
        {
          emailText && (
            <a
              id="footer-email"
              href={mail}
              class={`${CONTACT_VALUE_CLASS} break-all`}
            >
              {emailText}
            </a>
          )
        }
        {
          emailText && (
            <div class="mt-2 md:mt-3">
              <CopyButton
                value={emailText}
                label={COPY.contact.copyCta}
                targetId="footer-email"
              />
            </div>
          )
        }
      </div>
    </div>

    <nav
      aria-label={navLabel}
      class="md:text-right"
      data-reveal="fade"
      data-reveal-duration="0.5"
      data-reveal-stagger="0.06"
    >
      <p class="text-label font-ibm uppercase tracking-tight text-foreground-muted">
        {navLabel}
      </p>
      <ul
        class="mt-3 flex flex-col gap-1.5 list-none p-0 font-ibm text-label-lg uppercase tracking-tight md:items-end"
      >
        {
          links.map((link) => (
            <li>
              <a
                href={sectionHref(link.id, pathname)}
                class="transition-colors hover:text-highlight focus-visible:text-highlight"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={sectionHref("top", pathname)}
            class="transition-colors hover:text-highlight focus-visible:text-highlight"
          >
            {backToTop}
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Watermark: satu clip di container, bukan per span (spec @motion-designer).
       Di ukuran watermark (maks 609px @1440, 254px @320) string-nya muat satu
       baris di semua lebar, jadi split 2 span ala hero nggak perlu lagi —
       dan itu yang bikin tinggi footer 375 nutup ke angka frame (554). -->
  <div
    class="mt-8 md:mt-10 font-archivo font-bold uppercase leading-none text-[#4a4a4a] text-[clamp(2.5rem,6.7vw,6rem)]"
    data-reveal="clip"
    data-reveal-duration="0.8"
  >
    AXELO.DEV
  </div>

  {
    socials.length > 0 && (
      <div
        class="mt-10 flex flex-col gap-2 md:flex-row md:items-baseline md:gap-8"
        data-reveal="fade"
        data-reveal-duration="0.5"
        data-reveal-delay="0.15"
      >
        <p class="text-label font-ibm uppercase tracking-tight text-foreground-muted">
          {socialsLabel}
        </p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 list-none p-0 font-ibm text-label-lg">
          {socials.map((social) => (
            <li>
              <a href={social.url} target="_blank" rel="noopener noreferrer">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div
    class="mt-6 md:mt-8 border-t border-base-300/40 pt-3 flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between font-ibm text-label text-foreground-muted"
  >
    <p class="m-0">© {new Date().getFullYear()} {SITE.name}</p>
    {serviceTagline && <p class="m-0">{serviceTagline}</p>}
  </div>
</footer>
