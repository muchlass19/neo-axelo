---
// const { title } = Astro.props;
interface Props {
  title: string;
  variant?: "primary" | "secondary";
  size?: "sm" | "lg" | "xl";
}

const { title, variant = "primary", size = "xl" } = Astro.props;

const colorClasses =
  variant === "secondary"
    ? "border border-highlight bg-base-100 text-highlight"
    : "bg-highlight text-base-100";
const sizeClasses = `text-${size}`;
---

<div class="btn-wrapper inline-flex gap-2">
  <button
    class={`button-main ${colorClasses} ${sizeClasses} whitespace-nowrap inline cursor-pointer px-8 py-2 font-ibm font-semibold tracking-tight uppercase`}
  >
    {title}
  </button>
  <button
    class={`button-shrink ${colorClasses} ${sizeClasses} whitespace-nowrap inline cursor-pointer px-4 py-2 font-ibm font-semibold uppercase`}
    >+</button
  >
</div>

<script>
  import { gsap } from "gsap";

  let isMobile = window.innerWidth < 1000;
  const buttons = document.querySelectorAll(".btn-wrapper");

  buttons.forEach((wrapper) => {
    const buttonShrink = wrapper.querySelector<HTMLElement>(".button-shrink")!;
    const buttonMain = wrapper.querySelector<HTMLElement>(".button-main")!;

    if (wrapper && buttonShrink && buttonMain && !isMobile) {
      // 1. Hitung jarak pergeseran (Lebar tombol + gap)
      const gap = parseFloat(getComputedStyle(wrapper).gap) || 8;
      const moveMain = buttonShrink.offsetWidth + gap;
      const moveShrink = -(buttonMain.offsetWidth + gap);

      buttonMain.style.width = `${buttonMain.offsetWidth}px`;
      buttonMain.style.textAlign = "center";

      // 2. Buat satu Timeline yang di-PAUSE secara default
      const tl = gsap.timeline({ paused: true });

      tl.to(buttonShrink, { rotate: 60, duration: 0.25, ease: "power1.inOut" })
        .to(buttonShrink, { scale: 0, duration: 0.25, ease: "power1.inOut" })
        .addLabel("swap")
        .to(
          buttonMain,
          { x: moveMain, duration: 0.3, ease: "power2.inOut" },
          "swap",
        )
        .to(
          buttonShrink,
          { x: moveShrink, duration: 0.3, ease: "power2.inOut" },
          "swap",
        )
        .to(buttonShrink, { scale: 1, duration: 0.25, ease: "power1.inOut" })
        .to(buttonShrink, { rotate: 0, duration: 0.25, ease: "power1.inOut" });

      const originalText = buttonMain.innerText.trim();
      const chars = "0123456789!@#$%^&*()_+{}[]><~";

      let scrambleTween: gsap.core.Tween;
      let scrambleObj = { step: 0 };
      let hasScrambled = false;

      function playScramble() {
        hasScrambled = true;

        if (scrambleTween) {
          scrambleTween.kill();
        }

        scrambleObj.step = 0;
        scrambleTween = gsap.to(scrambleObj, {
          step: originalText.length,
          duration: 0.5,
          ease: "none",
          onUpdate: () => {
            let currentStep = Math.floor(scrambleObj.step);
            let result = "";

            for (let i = 0; i < originalText.length; i++) {
              if (originalText[i] === " ") {
                result += " ";
              } else if (i < currentStep) {
                result += originalText[i];
              } else {
                result += chars[Math.floor(Math.random() * chars.length)];
              }
            }
            buttonMain.innerText = result;
          },
          onComplete: () => {
            buttonMain.innerText = originalText;
          },
        });
      }

      wrapper.addEventListener("mouseenter", () => {
        console.log("test heree");
        tl.play();
        playScramble();
      });

      wrapper.addEventListener("mouseleave", () => {
        tl.reverse();

        if (scrambleTween) {
          scrambleTween.kill();
        }
        buttonMain.innerText = originalText;
      });
    }
  });
</script>
