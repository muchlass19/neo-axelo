---
/**
 * T-02 — Button polymorphic.
 * - `href` terisi  → render `<a href>` (navigasi nyata).
 * - `href` kosong  → render `<button disabled>` (non-interaktif: nol klik mati,
 *                    nol tab stop palsu). Untuk submit form nanti, kirim
 *                    `type="submit"` + `disabled={false}`.
 * Tombol "+" dibuang (ruling @user "sesuaikan sama design aja"): design nggak
 * punya elemen kedua, dan tanpa dia timeline swap-nya cuma mentranslasikan
 * tombol ke ruang kosong. Yang tinggal: scramble (tanda tangan CTA) + width lock.
 * Mekanisme hover pengganti (A/B/C dari @motion-designer) belum dipilih @user,
 * jadi belum ada state hover baru yang dipasang di sini.
 */
interface Props {
  title: string;
  href?: string | null;
  variant?: "primary" | "secondary";
  size?: "sm" | "lg" | "xl";
  class?: string;
  /** Accessible name, kalau beda dari label yang kelihatan. */
  ariaLabel?: string;
  disabled?: boolean;
  type?: "button" | "submit";
  /** Full-width di mobile (mis. kontrol kontak 375: WhatsApp satu baris penuh). */
  fullWidth?: boolean;
}

const {
  title,
  href = null,
  variant = "primary",
  size = "xl",
  class: className = "",
  ariaLabel,
  disabled,
  type = "button",
  fullWidth = false,
} = Astro.props;

// Map statis: `text-${size}` nggak pernah kebaca scanner Tailwind 4, jadi prop
// `size` sebelumnya no-op (CTA render tanpa kelas ukuran sama sekali).
const SIZE_CLASS: Record<NonNullable<Props["size"]>, string> = {
  sm: "text-sm",
  lg: "text-lg",
  xl: "text-xl",
};

const colorClasses =
  variant === "secondary"
    ? "border border-highlight bg-base-100 text-highlight"
    : "bg-highlight text-base-100";

const isDisabled = disabled ?? !href;
const isInteractive = Boolean(href) && !disabled;

const mainClasses = (cursor: string) =>
  `button-main ${colorClasses} ${SIZE_CLASS[size]} whitespace-nowrap ${cursor} ${fullWidth ? "w-full" : ""} min-h-[var(--size-control)] max-[400px]:px-3 px-4 md:px-8 py-2 font-ibm font-semibold tracking-tight uppercase`;
---

<div
  class={`btn-wrapper inline-flex ${fullWidth ? "w-full" : ""} ${className}`}
  data-cta={isInteractive ? "interactive" : "pending"}
>
  {
    href ? (
      <a
        href={href}
        class={mainClasses("inline-flex items-center justify-center")}
        aria-label={ariaLabel}
      >
        <span class="button-label-window">
          <span class="button-label" aria-hidden="true">{title}</span>
          <span class="button-label-ghost" aria-hidden="true">{title}</span>
        </span>
        <span class="sr-only">{ariaLabel ?? title}</span>
      </a>
    ) : (
      <button
        type={type}
        disabled={isDisabled}
        class={`${mainClasses("inline-flex items-center justify-center")} ${
          isDisabled ? "opacity-60 cursor-not-allowed" : "cursor-pointer"
        }`}
        aria-label={ariaLabel}
      >
        <span class="button-label-window">
          <span class="button-label" aria-hidden="true">{title}</span>
          <span class="button-label-ghost" aria-hidden="true">{title}</span>
        </span>
        <span class="sr-only">{ariaLabel ?? title}</span>
      </button>
    )
  }
</div>

<script>
  import { gsap } from "gsap";
  import { initRemeasure, onRemeasure } from "../../scripts/remeasure";

  const SCRAMBLE_CHARS = "0123456789!@#$%^&*()_+{}[]><~";
  const POINTER_QUERY = "(hover: hover) and (pointer: fine)";
  const REDUCED_QUERY = "(prefers-reduced-motion: reduce)";

  interface ButtonEntry {
    wrapper: HTMLElement;
    main: HTMLElement;
    label: HTMLElement;
    /** Baris duplikat yang masuk dari bawah — dia yang di-scramble, label asli
     *  tetap utuh saat diam (aturan @motion-designer). */
    ghost: HTMLElement;
    scramble: gsap.core.Tween | null;
  }

  const entries: ButtonEntry[] = [];

  const prefersReducedMotion = (): boolean =>
    window.matchMedia(REDUCED_QUERY).matches;

  const hasFinePointer = (): boolean =>
    window.matchMedia(POINTER_QUERY).matches;

  // T-08, disempitkan: dulu remeasure dipakai buat ngukur jarak swap (`+`).
  // Sekarang yang perlu diukur cuma lebar pill, karena scramble nulis innerText
  // per frame — tanpa width lock, lebarnya goyang tiap huruf berubah.
  function setupAnimation(entry: ButtonEntry): void {
    const { main, label, ghost } = entry;
    const originalText = label.dataset.original ?? label.textContent ?? "";
    label.dataset.original = originalText;
    ghost.dataset.original = originalText;

    entry.scramble?.kill();
    entry.scramble = null;
    entry.wrapper.classList.remove("is-rolling");
    ghost.textContent = originalText;

    // Lepas kunci lebar sebelum mengukur, kalau nggak lebar metrik font fallback
    // yang kepakai selamanya.
    main.style.width = "";
    main.style.textAlign = "";
    label.textContent = originalText;

    main.style.width = `${main.offsetWidth}px`;
    main.style.textAlign = "center";
  }

  function playScramble(entry: ButtonEntry): void {
    const { ghost: label } = entry;
    const originalText = label.dataset.original ?? "";
    const state = { step: 0 };

    entry.scramble?.kill();
    entry.scramble = gsap.to(state, {
      step: originalText.length,
      duration: 0.5,
      ease: "none",
      onUpdate: () => {
        const currentStep = Math.floor(state.step);
        let result = "";
        for (let i = 0; i < originalText.length; i++) {
          if (originalText[i] === " ") {
            result += " ";
          } else if (i < currentStep) {
            result += originalText[i];
          } else {
            result +=
              SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
          }
        }
        label.textContent = result;
      },
      onComplete: () => {
        label.textContent = originalText;
      },
    });
  }

  function resetLabel(entry: ButtonEntry): void {
    entry.scramble?.kill();
    entry.scramble = null;
    // Label asli nggak pernah ditulis ulang; yang dibalikin cuma baris duplikat.
    entry.ghost.textContent =
      entry.ghost.dataset.original ?? entry.label.textContent ?? "";
  }

  function teardown(entry: ButtonEntry): void {
    entry.wrapper.classList.remove("is-rolling");
    resetLabel(entry);
    entry.main.style.width = "";
    entry.main.style.textAlign = "";
  }

  function collectEntries(): ButtonEntry[] {
    const found: ButtonEntry[] = [];
    document.querySelectorAll<HTMLElement>(".btn-wrapper").forEach((wrapper) => {
      // CTA tanpa target (`data-cta="pending"`) nol motion sama sekali: kontrol
      // yang nggak bisa diklik tapi tetap beranimasi kebaca "lagi kerja".
      if (wrapper.dataset.cta !== "interactive") return;

      const main = wrapper.querySelector<HTMLElement>(".button-main");
      const label = wrapper.querySelector<HTMLElement>(".button-label");
      const ghost = wrapper.querySelector<HTMLElement>(".button-label-ghost");
      if (!main || !label || !ghost) return;
      if (main instanceof HTMLButtonElement && main.disabled) return;

      found.push({ wrapper, main, label, ghost, scramble: null });
    });
    return found;
  }

  function bind(entry: ButtonEntry): void {
    const wrapper = entry.wrapper as HTMLElement & { __btnBound?: boolean };
    if (wrapper.__btnBound) return;
    wrapper.__btnBound = true;

    const rollOn = (): void => {
      entry.wrapper.classList.add("is-rolling");
      playScramble(entry);
    };
    const rollOff = (): void => {
      entry.wrapper.classList.remove("is-rolling");
      resetLabel(entry);
    };

    wrapper.addEventListener("mouseenter", rollOn);
    // `mouseleave` tetap nyabut roll-nya walau fokus masih nyangkut di elemen
    // (klik lalu mouse pergi = nol roll yang latch).
    wrapper.addEventListener("mouseleave", rollOff);
    // Paritas keyboard tanpa nyalin motion pointer: klik mouse juga nge-fire
    // `focusin`, tapi elemennya nggak match `:focus-visible` — satu cek itu yang
    // misahin keyboard dari mouse, jadi user yang nge-Tab di Contact nggak dapet
    // tiga roll beruntun tepat waktu dia lagi baca labelnya.
    wrapper.addEventListener("focusin", () => {
      if (!entry.main.matches(":focus-visible")) return;
      rollOn();
    });
    wrapper.addEventListener("focusout", rollOff);
  }

  function activate(): void {
    if (prefersReducedMotion() || !hasFinePointer()) {
      entries.forEach(teardown);
      return;
    }
    entries.forEach((entry) => {
      bind(entry);
      setupAnimation(entry);
    });
  }

  const scheduleActivate = (): void => {
    window.requestAnimationFrame(activate);
  };

  const bootstrap = (): void => {
    entries.push(...collectEntries());
    activate();

    // T-08: remeasure setelah font swap + resize.
    onRemeasure(scheduleActivate);
    window.matchMedia(POINTER_QUERY).addEventListener("change", scheduleActivate);
    window
      .matchMedia(REDUCED_QUERY)
      .addEventListener("change", scheduleActivate);
  };

  initRemeasure();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootstrap, { once: true });
  } else {
    bootstrap();
  }
</script>

<style>
  /* Roll C (@motion-designer), dengan syarat window dari @figcraft-designer:
     window-nya setinggi satu baris label (diambil dari flow label aslinya, bukan
     angka) + `overflow: hidden`, di dalam padding vertikal pill — jadi tinggi pill
     NOL berubah. Yang gerak cuma transform: label asli naik keluar, duplikat masuk
     dari bawah. Nol geometri pill yang berubah, nol scale. */
  .button-label-window {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .button-label {
    display: block;
  }

  .button-label-ghost {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    display: block;
  }

  /* Keluar 0.25s power2.in (default), masuk 0.35s power3.out (state rolling). */
  .button-label,
  .button-label-ghost {
    transition: transform 0.25s cubic-bezier(0.55, 0.085, 0.68, 0.53);
  }

  .btn-wrapper.is-rolling .button-label,
  .btn-wrapper.is-rolling .button-label-ghost {
    transform: translateY(-100%);
    transition: transform 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  /* Keyboard: state fokus yang DIAM (color flip) buat semua orang, bukan cuma
     yang minta reduced motion — dan itu feedback yang lebih jelas dari roll,
     karena roll-nya dipicu pointer, bukan fokus (@motion-designer). */
  .btn-wrapper[data-cta="interactive"] .button-main:focus-visible {
    background-color: var(--color-base-100);
    color: var(--color-highlight);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  /* Baseline B: di bawah reduced-motion roll + scramble mati, hover jadi color
     flip saja — satu aturan buat primary dan secondary (dua-duanya invert). */
  @media (prefers-reduced-motion: reduce) {
    .btn-wrapper[data-cta="interactive"] .button-main {
      transition:
        background-color 0.2s ease,
        color 0.2s ease;
    }

    .btn-wrapper[data-cta="interactive"] .button-main:hover {
      background-color: var(--color-base-100);
      color: var(--color-highlight);
    }
  }
</style>
