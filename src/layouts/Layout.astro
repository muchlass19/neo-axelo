---
import "../styles/global.css";
// import "../styles/preloader.css";

import Navbar from "../components/Navbar.astro";
import Preloader from "../components/Preloader.astro";
import { SITE } from "../config/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- T-01: cuma Archivo Black (headline hero) yang di-preload. IBM Plex Mono
         dipakai di bawah fold, biar nggak rebut bandwidth LCP. -->
    <link
      rel="preload"
      href="/fonts/archivo-black-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <title>{SITE.name}</title>
  </head>
  <body class="bg-base-100 text-foreground">
    <Preloader />
    <Navbar />
    <slot />

    <script>
      const originalTitle = document.title;

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          document.title = "👋 Come back! We miss you.";
        } else {
          document.title = originalTitle;
        }
      });
    </script>
  </body>
</html>
