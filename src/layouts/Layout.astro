---
import "../styles/global.css";
// import "../styles/preloader.css";

import Navbar from "../components/Navbar.astro";
import Preloader from "../components/Preloader.astro";
import { COPY } from "../config/copy";
import { SITE, siteBaseUrl } from "../config/site";

interface Props {
  /** Judul halaman; dipakai buat <title> + og:title. Default: nama site. */
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;

// F1-09 — fail-closed: tanpa `SITE.domain`, canonical/og:url/description
// nggak dirender sama sekali (nol URL yang salah nempel di halaman).
const baseUrl = siteBaseUrl();
const canonical = baseUrl ? new URL(Astro.url.pathname, baseUrl).href : "";
const description = COPY.heroIntro.trim();

// F1-03: brand loader cuma di home.
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- T-01: cuma Archivo Black (headline hero) yang di-preload. IBM Plex Mono
         dipakai di bawah fold, biar nggak rebut bandwidth LCP. -->
    <link
      rel="preload"
      href="/fonts/archivo-black-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
  </head>
  <body class="bg-base-100 text-foreground">
    <Preloader full={isHome} />
    <Navbar />
    <slot />

    <script>
      const originalTitle = document.title;

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          document.title = "👋 Come back! We miss you.";
        } else {
          document.title = originalTitle;
        }
      });
    </script>
  </body>
</html>
