---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { COPY } from "../../config/copy";

import anessaWeb from "../../../public/projects/anessa/anessa-web.png";
import anessaBackground from '../../../public/projects/anessa/anessa_background.jpg';
import anessaChallenge from '../../../public/projects/anessa/anessa_challenge.jpg'
import daihatsuWeb from "../../../public/projects/daihatsu-web.png";
import daihatsuOm from "../../../public/projects/daihatsu-om.png";
import daihatsuSparepart from "../../../public/projects/daihatsu-sparepart.png";

export function getStaticPaths() {
  return [
    {
      params: { slug: "anessa-web" },
      props: {
        title: "Anessa Main Website",
        image: anessaWeb,
        about:
          "Introducing Anessa’s sun care expertise to Indonesia through a refined digital experience",
        services: ["UI Design", "UX Design", "Web Development"],
        backgroundImage: anessaBackground,
        backgroundTitle:
          "Bringing Anessa’s sun care expertise to Indonesia through a refined digital experience",
        backgroundDesc:
          "<p>Originating from Japan, Anessa is a premium sun care brand known for its advanced UV protection technology and skincare expertise. As the brand continues to connect with consumers in Indonesia, its digital presence plays an important role in communicating its product innovations, benefits, and commitment to everyday sun protection.</p><p>The project focused on creating a digital experience that reflects Anessa’s premium identity while making it easier for consumers to explore its product range, understand its sun care solutions, and discover the brand’s approach to protecting skin under the sun.</p>",
        challengeImage: anessaChallenge,
        challengeTitle: "Balancing advanced sun care technology with a premium digital experience.",
        challengeDesc: "<p>Anessa’s challenge was to communicate its advanced UV protection technology and skincare benefits in a way that feels clear, engaging, and relevant to Indonesian consumers. With a diverse product range designed for different skin needs and lifestyles, the digital experience needed to make product discovery intuitive without overwhelming visitors with technical information.</p><p>The website also needed to reflect Anessa’s premium Japanese identity while helping consumers understand the benefits of each product and find the right sun care solutions for their needs. Balancing product education, brand storytelling, and intuitive navigation was essential to creating a digital experience that feels both informative and refined.</p>"
      },
    },
    {
      params: { slug: "daihatsu-web" },
      props: {
        title: "Daihatsu Main Website",
        image: daihatsuWeb,
        about:
          "Bringing Daihatsu’s automotive legacy to life through a modern digital experience for Indonesia",
        services: ["UI Design", "UX Design", "Web Development"],
        backgroundVideo: "/projects/daihatsu_background.mp4",
        backgroundTitle:
          "Bringing Daihatsu's Sahabat spirit to millions of Indonesians through a modern digital flagship",
        backgroundDesc:
          "<p>Daihatsu has been a Sahabat (close companion) for Indonesian families for decades, with a diverse lineup spanning city cars, MPVs, and commercial vehicles. As car buying journeys increasingly begin online, the brand needed a digital flagship that could carry that trust into the modern web.</p><p>The project focused on creating a website where visitors can explore every model, compare specifications and prices, find nearby dealers, and book test drives, all within an experience that feels warm, reliable, and unmistakably Daihatsu.</p>",
        challengeVideo: "/projects/daihatsu_challenge.mp4",
        challengeTitle: "Balancing rich product content with a fast, effortless browsing experience.",
        challengeDesc: "<p>With many models, variants, colors, and price lists to present, the challenge was keeping the experience light and intuitive instead of overwhelming. Visitors range from first-time buyers to loyal owners, each arriving with different questions.</p><p>The website needed to surface the right information at the right moment, from model discovery to dealer contact, without sacrificing loading speed or clarity. Balancing comprehensive content, clear navigation, and consistent performance across devices was essential to an experience that feels effortless from first visit to test drive booking.</p>"
      },
    },
    {
      params: { slug: "daihatsu-om" },
      props: {
        title: "Daihatsu Owner Manual PWA",
        image: daihatsuOm,
        about:
          "Transforming Daihatsu’s owner manuals into an accessible, app-like digital experience through progressive web technology",
        services: ["UI Design", "UX Design", "Web Development"],
        backgroundVideo: "/projects/daihatsu_background.mp4",
        backgroundTitle:
          "Turning thick paper manuals into a digital companion every Daihatsu owner carries",
        backgroundDesc:
          "<p>Every Daihatsu vehicle comes with a printed owner's manual, yet these booklets are easily lost, damaged, or left at home exactly when they are needed most. Daihatsu saw an opportunity to give owners a better alternative that lives on the device they always carry.</p><p>The project focused on rebuilding the owner manual as a progressive web app: installable, searchable, and available offline, so guidance on maintenance, warning indicators, and everyday operation is always within reach.</p>",
        challengeVideo: "/projects/daihatsu_challenge.mp4",
        challengeTitle: "Making dense technical documentation searchable and readable on any screen.",
        challengeDesc: "<p>Hundreds of pages of procedures, diagrams, and safety warnings had to be restructured for small screens without losing accuracy. Owners in urgent situations need answers in seconds, not after flipping through chapters.</p><p>The experience needed powerful search, clear hierarchies, and offline caching that keeps working with poor connectivity. Balancing technical precision, readability, and app-like performance was essential to a manual owners genuinely trust and use.</p>"
      },
    },
    {
      params: { slug: "daihatsu-sparepart" },
      props: {
        title: "Daihatsu Sparepart Catalog",
        image: daihatsuSparepart,
        about:
          "Digitizing Daihatsu’s spare parts catalog to simplify parts discovery through an intuitive, user-friendly experience",
        services: ["UI Design", "UX Design", "Web Development"],
        backgroundVideo: "/projects/daihatsu_background.mp4",
        backgroundTitle:
          "Digitizing thousands of genuine parts into a catalog anyone can navigate",
        backgroundDesc:
          "<p>Finding the right spare part used to mean flipping through printed catalogs or relying entirely on workshop staff, a slow process prone to error. With countless parts across many models and years, Daihatsu needed a digital catalog that workshops and owners could explore with confidence.</p><p>The project focused on creating a catalog experience where parts can be browsed by model and category, identified precisely by part number, and verified as genuine Daihatsu components.</p>",
        challengeVideo: "/projects/daihatsu_challenge.mp4",
        challengeTitle: "Simplifying complex part hierarchies without losing technical precision.",
        challengeDesc: "<p>Spare part data is inherently complex: overlapping model years, variant-specific components, and long part numbers that must match exactly. Simplifying this into a friendly interface risked hiding details professionals depend on.</p><p>The catalog needed intuitive browsing for casual users alongside precise filtering for experts, with zero tolerance for mismatched parts. Balancing simplicity, depth, and data accuracy was essential to a catalog that speeds up ordering instead of complicating it.</p>"
      },
    },
  ];
}

const { title, image, about, services, backgroundImage, backgroundVideo, backgroundTitle, backgroundDesc, challengeTitle, challengeDesc, challengeImage, challengeVideo } = Astro.props;
---

<Layout title={title} description={about}>
  <section class="project-detail-hero">
    <div class="project-hero-frame">
      <p class="project-hero-eyebrow text-label font-ibm uppercase tracking-tight text-foreground-muted">
        {COPY.caseStudyEyebrow}
      </p>
      <div class="project-hero-media">
        <h1 class="project-hero-title font-ibm text-white">{title}</h1>
        <div class="project-hero-image">
          <Image src={image} alt={title} loading="eager" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="project-about">
    <div class="about-left">
      <p class="about-label">About</p>
      <p class="about-desc">{about}</p>
    </div>
    <div class="about-right">
      <p class="about-label">Services</p>
      <ul class="service-list">
        {(services ?? []).map((service) => <li class="service-item text-2xl" data-text={service}>{service}</li>)}
      </ul>
    </div>
  </section>

  <section class="project-background w-full">
    <div class="background-head">
      <p class="about-label">Background</p>
      <p class="background-title">{backgroundTitle}</p>
    </div>

    <div class="background-right">
      {backgroundVideo ? (
        <video class="w-full h-full object-cover" src={backgroundVideo} autoplay muted loop playsinline preload="auto" aria-label={backgroundTitle} />
      ) : (
        <Image class="w-full h-full object-cover" src={backgroundImage} alt={backgroundTitle} loading="eager" decoding="async" />
      )}
    </div>

    <div class="background-body text-foreground-muted" set:html={backgroundDesc} />
  </section>

  <section class="project-challenge grid grid-cols-1 md:grid-cols-2 w-full">
    <div class="challenge-left">
      {challengeVideo ? (
        <video class="w-full h-full object-cover" src={challengeVideo} autoplay muted loop playsinline preload="auto" aria-label={challengeTitle} />
      ) : (
        <Image class="w-full h-full object-cover" src={challengeImage} alt={challengeTitle} />
      )}
    </div>
    <div class="challenge-right flex flex-col justify-center gap-2">
      <p class="about-label">Challenge</p>
      <p class="background-title">{challengeTitle}</p>
      <div class="background-body text-foreground-muted" set:html={challengeDesc} />
    </div>
  </section>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { initRemeasure, onRemeasure } from "../../scripts/remeasure";
    import { waitForEntryGate, type EntryGateResult } from "../../scripts/entryGate";
    import { splitIntoVisualLines } from "../../scripts/splitLines";

    gsap.registerPlugin(ScrollTrigger);
    initRemeasure();

    const initReveal = () => {
      try {
        const imageBox = document.querySelector(
          ".project-hero-image",
        ) as HTMLElement | null;
        const imageEl = imageBox?.querySelector("img") as HTMLElement | null;
        if (!imageBox) return;

        gsap.set(imageBox, { clipPath: "inset(100% 0 0 0)" });
        if (imageEl)
          gsap.set(imageEl, { scale: 1.5, transformOrigin: "center center" });

        const imageIsReady = (): boolean =>
          Boolean(imageEl && imageEl.complete && imageEl.naturalWidth > 0);

        const revealInstantly = (): void => {
          gsap.set(imageBox, { clipPath: "inset(0% 0 0 0)" });
          if (imageEl) gsap.set(imageEl, { scale: 1 });
        };

        // F1-03b: kalau cap menang DAN gambarnya belum siap, durasi dipotong ke
        // 0.7s — nggak ada gunanya animasi 1.1s buat kotak yang belum ada isinya.
        const playReveal = (gateResult: EntryGateResult): void => {
          const duration =
            gateResult === "timeout" && !imageIsReady() ? 0.7 : 1.1;

          const tl = gsap.timeline();
          tl.to(
            imageBox,
            { clipPath: "inset(0% 0 0 0)", duration, ease: "power3.out" },
            0,
          );
          if (imageEl) {
            tl.to(imageEl, { scale: 1, duration, ease: "power3.out" }, 0);
          }
        };

        // Entry gate (spec @motion-designer): start setelah gambar ke-decode DAN
        // satu siklus remeasure selesai, cap 600ms — biar 1.1s pertama bukan
        // reveal kotak kosong. Reduced motion: tampil instan, nol animasi.
        const revealMedia = gsap.matchMedia();
        revealMedia.add("(prefers-reduced-motion: reduce)", revealInstantly);
        revealMedia.add("(prefers-reduced-motion: no-preference)", () => {
          void waitForEntryGate({ imageTargets: [imageBox] }).then(playReveal);
        });
      } catch {
        // Reveal gagal: biarkan gambar tampil apa adanya, tanpa console noise.
      }

      ScrollTrigger.refresh();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initReveal, { once: true });
    } else {
      initReveal();
    }

    // Reveal clip-path yang sama seperti gambar hero, untuk gambar
    // background & challenge. Replay setiap section masuk viewport,
    // baik scroll dari atas maupun dari bawah.
    const initScrollReveals = () => {
      try {
        const boxes = document.querySelectorAll(".background-right, .challenge-left");
        if (!boxes.length) return;

        boxes.forEach((box) => {
          const el = box as HTMLElement;
          if ((el as any).__revealReady) return;
          (el as any).__revealReady = true;

          const img = el.querySelector("img, video") as HTMLElement | null;

          gsap.set(el, { clipPath: "inset(100% 0 0 0)" });
          if (img) gsap.set(img, { scale: 1.5, transformOrigin: "center center" });

          const tl = gsap.timeline({ paused: true });
          tl.to(
            el,
            {
              clipPath: "inset(0% 0 0 0)",
              duration: 1.1,
              ease: "power3.out",
            },
            0,
          );
          if (img) {
            tl.to(
              img,
              {
                scale: 1,
                duration: 1.1,
                ease: "power3.out",
              },
              0,
            );
          }

          ScrollTrigger.create({
            trigger: el,
            start: "top 80%",
            onEnter: () => tl.restart(),
            onEnterBack: () => tl.restart(),
          });
        });

        ScrollTrigger.refresh();
      } catch {
        // Reveal gagal: konten tetap tampil.
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initScrollReveals, { once: true });
    } else {
      initScrollReveals();
    }

    // Split baris dipakai bersama: `src/scripts/splitLines.ts` (reuse, bukan
    // splitter kedua) — dipakai juga oleh reveal.ts di section home.

    let aboutTrigger: any = null;
    let aboutObserver: IntersectionObserver | null = null;

    const initAboutLines = () => {
      try {
        const desc = document.querySelector(
          ".about-desc",
        ) as HTMLElement | null;
        const section = document.querySelector(
          ".project-about",
        ) as HTMLElement | null;
        if (!desc || !section) return;

        // Bersihkan trigger & observer lama (mis. HMR / resize) supaya tidak duplikat.
        if (aboutTrigger) {
          aboutTrigger.kill();
          aboutTrigger = null;
        }
        if (aboutObserver) {
          aboutObserver.disconnect();
          aboutObserver = null;
        }

        const lines = splitIntoVisualLines(desc);
        if (!lines.length) return;

        gsap.set(lines, { yPercent: 115 });

        const linesTl = gsap.timeline({ paused: true });
        linesTl.to(lines, {
          yPercent: 0,
          duration: 0.9,
          ease: "power3.out",
          stagger: 0.12,
        });

        const playLines = () => {
          linesTl.restart();
        };

        // Tetap daftarkan ScrollTrigger (refresh posisi), tapi pemicu utama
        // pakai IntersectionObserver native yang tidak bergantung kalkulasi scroll.
        aboutTrigger = ScrollTrigger.create({
          trigger: section,
          start: "top 90%",
        });

        aboutObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) playLines();
            });
          },
          { threshold: 0.15 },
        );
        aboutObserver.observe(section);

        ScrollTrigger.refresh();
      } catch {
        // Split gagal: teks tampil apa adanya (nggak ada teks yang hilang).
      }
    };

    // Reveal per-baris yang sama untuk copywriting section background & challenge.
    // Replay setiap elemen masuk viewport (dari atas maupun bawah).
    const setupScrollLineReveal = (el: HTMLElement) => {
      const prevObserver = (el as any).__lineObserver as IntersectionObserver | undefined;
      if (prevObserver) prevObserver.disconnect();

      const lines = splitIntoVisualLines(el);
      if (!lines.length) return;

      gsap.set(lines, { yPercent: 115 });

      const tl = gsap.timeline({ paused: true });
      tl.to(lines, {
        yPercent: 0,
        duration: 0.9,
        ease: "power3.out",
        stagger: 0.12,
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) tl.restart();
          });
        },
        { threshold: 0.2 },
      );
      observer.observe(el);
      (el as any).__lineObserver = observer;
    };

    const initCopyReveals = () => {
      try {
        const targets = document.querySelectorAll(".background-title, .background-body p");
        targets.forEach((target) => setupScrollLineReveal(target as HTMLElement));
        ScrollTrigger.refresh();
      } catch {
        // Reveal gagal: teks tetap tampil normal.
      }
    };

    const bootAbout = () => {
      const run = () =>
        requestAnimationFrame(() => {
          requestAnimationFrame(initAboutLines);
          requestAnimationFrame(initCopyReveals);
        });
      if (document.fonts?.ready) {
        document.fonts.ready.then(run);
      } else {
        run();
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bootAbout, { once: true });
    } else {
      bootAbout();
    }
    // Pastikan split dilakukan setelah layout final (gambar hero selesai dimuat).
    window.addEventListener("load", () =>
      requestAnimationFrame(() => {
        initAboutLines();
        initCopyReveals();
      }),
    );

    // T-08: font swap mengubah `offsetTop` tiap kata, jadi grouping baris yang
    // lama jadi salah. Split ulang dipicu hook remeasure (fonts.ready + load +
    // resize yang sudah di-debounce), bukan listener lokal.
    onRemeasure(() =>
      requestAnimationFrame(() => {
        initAboutLines();
        initCopyReveals();
      }),
    );
  </script>
</Layout>

<style>
  .project-detail-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    overflow: hidden;
  }

  /* F1-16 (@project-manager): `100svh` dulu dipasang tanpa breakpoint, jadi hero
     ngikutin tinggi viewport di semua lebar — @375 (svh 812) isinya cuma ~175px,
     78% kosong. `900` itu hasil ukur di satu viewport, bukan nilai spesifikasi:
     dipaku jadi `md:min-h-[900px]` malah matiin sifat viewport-relative di
     desktop (monitor 1080 harusnya hero 1080). Jadi: mobile content-driven,
     desktop persis seperti sebelumnya. */
  @media (min-width: 768px) {
    .project-detail-hero {
      min-height: 100svh;
    }
  }

  .project-hero-frame {
    position: relative;
    width: min(90vw, 1180px);
    margin: 0 auto;
  }

  /* Judul straddle di tepi atas GAMBAR, bukan di tepi atas frame — kalau
     anchor-nya frame, dia bakal duduk persis di baris eyebrow (yang nabrak
     glyph judul di 768–1024, di mana judul nowrap-nya hampir selebar frame).
     Jadi media jadi positioning context, dan eyebrow punya ruang bersih di atas. */
  .project-hero-media {
    position: relative;
  }

  /* F1-16: eyebrow `Case study` — konstanta di tier label (12,96px @1440,
     uppercase muted), bukan `Case study — {title}` (itu mengulang H1 tepat di
     bawahnya; pola yang baru kita buang di 404). */
  .project-hero-eyebrow {
    margin: 0 0 1rem;
  }

  .project-hero-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
  }

  .project-hero-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    filter: brightness(0.6);
    transition: filter 300ms ease;
  }

  .project-hero-image:hover :global(img) {
    filter: brightness(1);
  }

  .project-hero-title {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translate(-50%, -50%);
    z-index: 2;
    margin: 0;
    text-align: center;
    font-size: clamp(2.25rem, 6vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #ffffff;
    white-space: nowrap;
    pointer-events: none;
  }

  /* @768 ke atas: judul tetap straddle di tepi atas gambar (komposisi yang sudah
     ada, nol perubahan tinggi hero 900) — jarak eyebrow dikunci lebih besar dari
     separuh tinggi judul (86,4px / 2 = 43px @1440, 46px / 2 = 23px @768) biar
     nggak nyentuh glyph-nya. */
  @media (min-width: 768px) {
    .project-hero-eyebrow {
      margin-bottom: 3.75rem;
    }
  }

  @media (max-width: 767px) {
    /* Frame Project 375: eyebrow → judul → gambar, semuanya di alur, kiri.
       Judul nggak lagi di-absolute biar hero mobile jadi content-driven
       (351–379), bukan ikut tinggi viewport. */
    .project-detail-hero {
      padding: 2rem 2rem 2.75rem;
    }

    .project-hero-title {
      position: static;
      transform: none;
      text-align: left;
      font-size: clamp(1.75rem, 8vw, 3rem);
      white-space: normal;
      max-width: 100%;
      margin: 0 0 1.25rem;
    }
  }

  .project-about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 2rem 0;
    width: min(90vw, 1180px);
    margin: 0 auto;
  }

  .about-left {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 12rem;
  }

  .about-right {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: flex-end;
    align-items: flex-end;
    text-align: right;
  }

  .about-label {
    margin: 0;
    text-transform: uppercase;
    font-size: var(--text-label);
    line-height: 1.2;
    letter-spacing: 0.08em;
    color: var(--color-foreground-muted, #818081);
    font-family: var(--font-ibm, monospace);
  }

  /* F1-01 — clamp lama `clamp(3rem, 2vw, 1.25rem)` punya min (48px) > max
     (20px), jadi nilai-nya dipaku ke MIN di semua viewport (terukur 48px di
     375px), dan `font-family` nggak pernah diset sehingga jatuh ke system sans.
     Sekarang: tier statement + Mono 500. */
  .about-desc {
    margin: 0;
    text-align: left;
    font-family: var(--font-ibm, monospace);
    font-weight: 500;
    font-size: var(--text-statement);
    line-height: 1.35;
    color: var(--color-foreground, #eeeeee);
    max-width: 32rem;
  }

  /* F1-01 — pola clamp terbalik yang sama (`clamp(2rem, 2vw, 1.25rem)` → 32px
     kekunci) + font-family nggak pernah diset. */
  .background-title {
    margin: 0;
    text-align: left;
    font-family: var(--font-ibm, monospace);
    font-weight: 500;
    font-size: var(--text-statement);
    line-height: 1.35;
    color: var(--color-foreground, #eeeeee);
    max-width: 32rem;
  }

  /* F1-15 (frame project-1440-v2 @figcraft-designer): dua blok 1.267px yang
     identik tinggi berhenti monoton. `background` = media penuh (1440×560)
     dengan judul di atas + body di bawah; `challenge` tetap split tapi
     diukur lebih pendek (media 620) dengan hairline sebagai penanda blok. */
  .project-background {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem 0;
  }

  .background-head,
  .project-background > .background-body {
    width: min(90vw, 1180px);
    margin: 0 auto;
  }

  .background-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Frame: judul background dibaca full-width di dalam kontainer (2 baris @1440),
     bukan kekunci di 32rem kayak blok text-column. Body-nya tetap dibatasi biar
     barisnya nggak jadi terlalu panjang buat dibaca. */
  .project-background .background-title {
    max-width: none;
  }

  .project-background > .background-body {
    max-width: 42rem;
  }

  .project-background > .background-right {
    width: 100%;
  }

  .project-challenge {
    border-top: 1px solid var(--color-base-300, #3e3e42);
  }

  @media (min-width: 768px) {
    .project-background > .background-right {
      height: 560px;
    }

    .challenge-left {
      height: 620px;
    }
  }

  .project-challenge {
    align-items: stretch;
    grid-template-rows: minmax(0, 1fr);
  }

  .challenge-right {
    justify-content: center;
    text-align: left;
    padding: 2rem;
    min-height: 0;
    min-width: 0;
  }

  .background-right,
  .challenge-left {
    min-height: 0;
    min-width: 0;
    overflow: hidden;
  }

  .background-right :global(img),
  .challenge-left :global(img),
  .background-right :global(video),
  .challenge-left :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .background-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
